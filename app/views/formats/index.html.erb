<section class="app-page catalog-page">
  <se-nav-tabs value="<%= @tab %>" options="<%= [{id: 'export', label: 'Export', href: import_export_path}, {id: 'import', label: 'Import', href: import_export_path(tab: 'import')}].to_json %>"></se-nav-tabs>
  <% if @tab == 'import' %><se-empty-illustration variant="workflow" title="Manual import is coming later" subtitle="Connect a GitHub repository from project settings to synchronize YAML files."></se-empty-illustration>
  <% else %>
    <se-collection type="table" columns="minmax(0,1fr) minmax(0,1fr) minmax(0,1fr)">
      <se-list-header><span>Key</span><span>English</span><span>Dutch</span></se-list-header>
      <% @state.keys.each do |key| %>
        <% next if key.payload.kind == 'branch' %>
        <se-list-row <%= 'variant="secondary"'.html_safe if @state.plural_parent(key) %>><div class="catalog-key"><se-code><%= @state.path(key) %></se-code><% if key.payload.kind == 'plural' %><se-badge text="Plural" tone="important"></se-badge><% end %></div>
          <% %w[en nl].each do |locale| %><span class="catalog-translation"><%= catalog_text(@state.translation(key.id, locale)&.payload&.value) %></span><% end %>
        </se-list-row>
      <% end %>
    </se-collection>
    <%= form_with url: import_export_path, method: :get do %><se-select name="export_format" label="Export format" value="<%= @format %>" data-auto-submit options='[{"id":"yaml","label":"YAML"},{"id":"csv","label":"CSV"},{"id":"xlsx","label":"Excel"}]'></se-select><% end %>
    <% if @format == 'xlsx' %><se-card><se-text>Excel is a binary workbook and cannot be displayed as code. It contains the same key and language columns.</se-text></se-card><% else %>
      <div class="format-preview-files <%= 'format-preview-files--single' if @files.one? %>"><% @files.each do |name, value| %><section class="format-preview-file"><se-code><%= name %></se-code><se-code-editor readonly autosize wrap language="<%= @format %>" value="<%= value %>" data-controller="format-preview"></se-code-editor></section><% end %></div>
    <% end %>
  <% end %>
</section>
