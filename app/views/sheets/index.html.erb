<section class="app-page">
  <%= render "projects/navigation" %>
  <header class="app-heading">
    <se-title level="page">Sheets</se-title>
    <% if @sheets.any? && policy(@sheet).create? %><se-button text="Create sheet" icon="plus" data-open-modal="sheet-create-modal"></se-button><% end %>
  </header>
  <% if @sheets.any? %>
    <div class="app-grid app-sheet-grid"><% @sheets.each do |sheet| %><se-project-card description="<%= sheet.description %>" <% if sheet.image_data.present? %>banner-image="<%= image_project_sheet_path(@project,sheet,v: sheet.updated_at.to_i) %>"<% end %> title="<%= sheet.name %>" metadata="<%= sheet.effective_visibility.capitalize %>" href="<%= project_sheet_path(@project, sheet) %>"></se-project-card><% end %></div>
    <%= render "shared/table_pagination", url: project_sheets_path(@project) %>
  <% else %>
    <se-empty-illustration variant="folders" title="No sheets yet" text="Sheets keep your translations organized. Create your first sheet to get started in this project.">
      <% if policy(@sheet).create? %><se-button text="Create sheet" icon="plus" data-open-modal="sheet-create-modal"></se-button><% end %>
    </se-empty-illustration>
  <% end %>
  <% if policy(@sheet).create? %>
    <se-modal id="sheet-create-modal" title="Create sheet" size="medium" cancel-label="Cancel" confirm-label="Create sheet" <%= "open" if @sheet.errors.any? %>>
      <%= form_with model: [@project, @sheet], class: "app-form", data: { controller: "slug-mirror", action: "input->slug-mirror#update" }, html: { novalidate: true } do %>
        <% @sheet.errors[:base].each do |error| %><se-text role="alert"><%= error %></se-text><% end %>
        <div class="app-form-row">
        <se-input data-slug-mirror-target="source" label="Sheet name" name="sheet[name]" value="<%= @sheet.name %>" error="<%= @sheet.errors[:name].first %>"></se-input>
        <se-input data-slug-mirror-target="destination" label="Identifier" name="sheet[slug]" value="<%= @sheet.slug %>" error="<%= @sheet.errors[:slug].first %>" hint="Generated from the name until you edit it. Use lowercase letters, numbers and underscores."></se-input>
        </div>
        <se-select label="Default language" name="sheet[default_language_id]" value="<%= @sheet.default_language_id || @project.languages.where(enabled: true).order(:created_at).first&.id %>" options="<%= @project.languages.where(enabled: true).order(:name).map { |l| {id: l.id, label: l.name} }.presence&.to_json || [{id: '', label: 'None'}].to_json %>"></se-select>
        <se-select label="Visibility" name="sheet[visibility]" value="<%= @sheet.visibility %>" error="<%= @sheet.errors[:visibility].first %>" options='[{"id":"private","label":"Private"},{"id":"public","label":"Public"}]'></se-select>
        <% if @project.visibility == "private" %><se-text muted>Sheets in this private project stay private, even when set to public.</se-text><% end %>
      <% end %>
    </se-modal>
  <% end %>
</section>
