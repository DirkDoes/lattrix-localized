<% payload = key.recordable; plural = payload.pluralized && @sheet.pluralization_enabled? %>
<% display_key = @view != "tree" && !plural_form ? row["path"] : payload.name %>
<% collapsible = @view == 'tree' ? row['has_children'] : Array(@plural_children[key.id]).any? %>
<% hidden_form = plural_form && !%w[one other].include?(payload.name) && ![@left,@right].compact.any? { |language| @values[[key.id,language.id]] } %>
<se-list-row <%= 'hidden' if hidden_form %> <% if plural_form %>data-plural-parent="<%= key.parent_id %>" data-plural-category="<%= payload.name %>"<% end %> <%= 'variant="secondary"'.html_safe if plural_form %> data-key-row="<%= key.id %>" data-row-position="<%= row['position'] %>" level="<%= level %>" <%= 'guides' if level.to_i > 0 %> <%= 'collapsible data-tree-collapsible' if collapsible %>>
  <div class="translation-key" layout-mode="desktop-only">
    <se-code title="<%= row['path'] %>"><%= display_key %></se-code>
    <% if payload.description.present? %><se-tooltip content="<%= payload.description %>"><se-button variant="mini" icon="info" aria-label="Key description"></se-button></se-tooltip><% end %>
    <% if plural %><se-tooltip content="Translations belong to the Unicode categories, not this parent. One and other are always shown. Other categories appear when either selected language has a value, or when revealed from this menu. Missing categories are omitted from exports."><se-badge tone="important" text="Plural" tabindex="0"></se-badge><span data-content><strong>Pluralization</strong><br>Translations belong to Unicode categories, not the parent key. One and other are always shown. Unused categories are omitted from exports.<br><a class="app-reference-link" href="https://unicode.org/cldr/charts/49/supplemental/language_plural_rules.html" target="_blank" rel="noopener noreferrer">See how it works for your language <se-icon name="external-link"></se-icon></a></span></se-tooltip><% end %>
    <% if (@manage_keys || (plural && @reveal_plurals)) && !plural_form %>
      <% options = @manage_keys ? [{id: 'edit', label: 'Edit key', icon: 'pencil'}, {id: 'child', label: 'Add child key', icon: 'plus'}, {id: 'remove', label: 'Remove subtree', icon: 'trash', danger: true}] : [] %>
      <% missing = plural ? TranslationKey::PLURAL_CATEGORIES - %w[one other] : [] %>
      <% if missing.any? %>
        <% options << {heading: 'Pluralization', separator: @manage_keys} %>
        <% missing.each { |name| options << {id: 'plural', name: name, label: "Show #{name}", icon: 'plus'} } %>
      <% end %>
      <span class="app-table-actions"><se-menu variant="mini" icon-only label="Actions for <%= row['path'] %>" data-action="select->translation-table#keyAction" data-url="<%= edit_project_sheet_recording_path(@project,@sheet,key) %>" data-key="<%= key.id %>" data-path="<%= row['path'] %>" options="<%= options.to_json %>"></se-menu></span>
    <% end %>
  </div>
  <% [@left,@right].each do |language| %><div class="app-table-control"><%= render "sheets/cell", key: key, language: language %></div><% end %>
  <div class="translation-mobile-key" layout-mode="mobile-only"><se-code><%= row['path'] %></se-code><% if payload.description.present? %><se-tooltip content="<%= payload.description %>"><se-button variant="mini" icon="info" aria-label="Key description"></se-button></se-tooltip><% end %><% if plural && @reveal_plurals %><se-menu variant="mini" icon-only label="Plural categories for <%= row['path'] %>" data-action="select->translation-table#keyAction" data-key="<%= key.id %>" options="<%= (TranslationKey::PLURAL_CATEGORIES - %w[one other]).map { |name| {id: 'plural', name: name, label: "Show #{name}"} }.to_json %>"></se-menu><% end %><se-icon name="chevron" aria-hidden="true"></se-icon></div>
</se-list-row>
