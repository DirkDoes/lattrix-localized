<main class="app-auth"><se-card class="app-auth-card"><%= form_with model: resource, as: resource_name, url: password_path(resource_name), method: :put, class: "app-form", html: { novalidate: true } do |f| %><header><se-title level="section">Change password</se-title><se-text muted>Choose a new password for your account.</se-text></header><%= f.hidden_field :reset_password_token %><div class="app-form-fields"><se-input label="New password" name="user[password]" type="password" error="<%= resource.errors[:password].first %>"></se-input><se-input label="Confirm new password" name="user[password_confirmation]" type="password" error="<%= resource.errors[:password_confirmation].first %>"></se-input></div><footer class="app-form-actions"><se-button type="submit" variant="brand" icon="check" text="Change password"></se-button></footer><% end %></se-card></main>
