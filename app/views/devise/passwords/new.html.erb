<main class="app-auth"><se-card class="app-auth-card"><%= form_with model: resource, as: resource_name, url: password_path(resource_name), method: :post, class: "app-form", html: { novalidate: true } do %><header><se-title level="section">Reset password</se-title><se-text muted>We will email you reset instructions.</se-text></header><div class="app-form-fields"><se-input type="email" label="Email address" name="user[email]" value="<%= resource.email %>" icon="mail" error="<%= resource.errors[:email].first %>"></se-input></div><footer class="app-form-actions"><se-button type="submit" variant="brand" icon="send" text="Send reset instructions"></se-button></footer><% end %><nav class="app-auth-links"><se-button variant="link" href="<%= new_user_session_path %>" text="Back to login"></se-button></nav></se-card></main>
