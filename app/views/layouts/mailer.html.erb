<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <style>
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      body { margin: 0; background: #f4f7fb; color: rgb(23, 32, 51); font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      .mail-card { background: #ffffff; border: 1px solid #dfe5ee; border-radius: 18px; }
      .mail-muted { color: #64748b; }
      .mail-code { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
      @media (prefers-color-scheme: dark) {
        body { background: #0e1117 !important; color: #f8fafc !important; }
        .mail-card { background: #171b24 !important; border-color: #2d3442 !important; }
        .mail-muted { color: #a5adba !important; }
        .mail-code { background: rgb(23, 37, 84) !important; color: #bfdbfe !important; border-color: #1e40af !important; }
      }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
