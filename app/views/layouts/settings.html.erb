<%
  profile_name = current_user&.name.presence || "Your account"
  initials = profile_initials(profile_name)
  theme_preference = current_user&.theme_preference.presence_in(User::THEME_PREFERENCES) || "system"
  sidebar_projects = current_user ? policy_scope(Project).where(id: current_user.projects.select(:id)).order(:name).to_a : []
  show_sidebar = current_user.present?
%>
<!DOCTYPE html>
<html data-theme="<%= theme_preference == "dark" ? "dark" : "light" %>" data-se-theme="<%= theme_preference == "dark" ? "flat" : "clean" %>" data-theme-preference="<%= theme_preference %>">
  <head>
    <%= javascript_include_tag "theme", "data-turbo-track": "reload" %>
    <title><%= content_for(:title) || "Lattrix Localized" %></title><meta name="viewport" content="width=device-width,initial-scale=1"><%= csrf_meta_tags %><%= csp_meta_tag %><link rel="icon" href="/icons/lattrix/lattrix-icon-small-light.svg" type="image/svg+xml">
    <link rel="icon" href="/icons/lattrix/lattrix-icon-small-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)"><link rel="apple-touch-icon" href="/icon.png?v=lt">
    <%= stylesheet_link_tag "styles", "application", "data-turbo-track": "reload" %><%= javascript_include_tag "navigation_state", "simple-elements", defer: true, "data-turbo-track": "reload" %><%= javascript_include_tag "ui", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags "app_forms" %>
  </head>
  <body>
    <%= render "shared/toasts" %>
    <div class="app-shell">
      <se-topbar layout-mode="<%= show_sidebar ? 'mobile-only' : 'always' %>">
        <section data-start>
          <% if show_sidebar %><se-sidebar-toggle for="app-sidebar" layout-mode="mobile-only"></se-sidebar-toggle><% end %>
          <%= render "shared/layout_brand" %>

        </section>
        <section data-end>
          <% if current_user %>
          <%= render "shared/layout_profile", profile_name: profile_name, initials: initials %>
          <% else %><se-button text="Log in" href="<%= new_user_session_path %>"></se-button><% end %>
        </section>
      </se-topbar>
      <div class="app-scope-row">
        <% if show_sidebar %>
        <turbo-frame id="app-navigation" target="app-content">
        <se-sidebar id="app-sidebar" data-navigation-user="<%= current_user&.id || 'anonymous' %>" layout-mode="responsive" <%= "collapsed" if cookies[:sidebar_collapsed] == "true" %>>
          <header layout-mode="desktop-only"><%= render "shared/layout_brand", collapsible: true %></header>
          <section>
            <% if current_user %>
            <se-sidebar-chapter title="Project">
              <% if sidebar_projects.any? %>
              <se-sidebar-group id="projects-navigation" variant="page" label="Projects" icon="folder" href="<%= projects_path %>" <%= "active" if controller_path == "projects" && action_name == "index" %>>
                <% sidebar_projects.each do |sidebar_project| %>
                  <se-sidebar-button label="<%= sidebar_project.name %>" href="<%= project_path(sidebar_project) %>" icon="folder" <%= "active" if @project&.id == sidebar_project.id %>></se-sidebar-button>
                <% end %>
              </se-sidebar-group>
              <% else %>
                <se-sidebar-button label="Projects" icon="folder" href="<%= projects_path %>" <%= "active" if controller_path == "projects" && action_name == "index" %>></se-sidebar-button>
              <% end %>
              <se-sidebar-button href="<%= project_invites_path %>" label="Invitations" icon="mail" <%= "active" if controller_name == "project_invites" && action_name == "index" && params[:project_id].blank? %>></se-sidebar-button>
              <se-sidebar-button href="<%= import_export_path %>" label="Import and Export" icon="download" <%= "active" if controller_name == "formats" %>></se-sidebar-button>
            </se-sidebar-chapter>
            <% end %>
            <% if policy(User).index? %>
              <se-sidebar-chapter id="administration-navigation" title="Administration" collapsible collapsed>
                <se-sidebar-button href="<%= settings_users_path %>" label="Users" icon="users" <%= "active" if controller_name == "users" && action_name == "index" %>></se-sidebar-button>
                <se-sidebar-button href="<%= settings_projects_path %>" label="Projects" icon="folder" <%= "active" if controller_path == "settings/projects" %>></se-sidebar-button>
              </se-sidebar-chapter>
            <% end %>
          </section>
          <footer layout-mode="desktop-only"><%= render "shared/layout_profile", profile_name: profile_name, initials: initials %></footer>
        </se-sidebar>
        </turbo-frame>
        <% end %>
        <main class="se-page-layout__content app-content"><%= turbo_frame_tag "app-content", data: { turbo_action: "advance" } do %><%= yield %><% end %></main>
      </div>
    </div>
    <% if current_user %><%= button_to "Log out", destroy_user_session_path, method: :delete, form: { id: "logout-form", hidden: true } %><% end %>
  </body>
</html>
