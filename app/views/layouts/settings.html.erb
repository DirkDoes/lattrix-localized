<%
  profile_name = current_user.name.presence || current_user.email.split("@").first.humanize
  profile_initials = profile_name.split.map(&:first).join.first(2).upcase
  theme_preference = current_user.theme_preference.presence_in(User::THEME_PREFERENCES) || "system"
%>
<!DOCTYPE html>
<html data-theme="<%= theme_preference == "dark" ? "dark" : "light" %>" data-se-theme="<%= theme_preference == "dark" ? "flat" : "clean" %>" data-theme-preference="<%= theme_preference %>">
  <head>
    <title><%= content_for(:title) || "OathTemplate" %></title><meta name="viewport" content="width=device-width,initial-scale=1"><%= csrf_meta_tags %><%= csp_meta_tag %><link rel="icon" href="/icon.svg?v=lt" type="image/svg+xml"><link rel="apple-touch-icon" href="/icon.png?v=lt">
    <%= stylesheet_link_tag "styles", "application", "data-turbo-track": "reload" %><%= javascript_include_tag "simple-elements", defer: true, "data-turbo-track": "reload" %><%= javascript_include_tag "ui", defer: true, "data-turbo-track": "reload" %>
  </head>
  <body>
    <%= render "shared/toasts" %>
    <div class="se-page-layout se-page-layout--topbar">
      <se-topbar layout-mode="mobile-only"><section data-start><se-sidebar-toggle for="app-sidebar"></se-sidebar-toggle><se-layout-brand icon="/icon.svg" label="OathTemplate" href="<%= overview_path %>"></se-layout-brand></section><section data-end><se-profile data-profile-menu data-account-url="<%= edit_settings_user_path(current_user) %>" name="<%= profile_name %>" initials="<%= profile_initials %>" options='[{"id":"account","label":"Personal settings","icon":"settings"},{"id":"logout","label":"Log out","icon":"x","danger":true}]' compact></se-profile></section></se-topbar>
      <div class="se-page-layout__row">
        <se-sidebar id="app-sidebar" layout-mode="responsive">
          <header layout-mode="desktop-only"><se-layout-brand icon="/icon.svg" compact-icon="/icon.svg" label="OathTemplate" href="<%= overview_path %>" collapsible></se-layout-brand></header>
          <section><se-sidebar-chapter title="Workspace"><se-sidebar-button href="<%= overview_path %>" label="Dashboard" icon="dashboard" <%= "active" if controller_name == "overview" %>></se-sidebar-button></se-sidebar-chapter><% if settings_access? %><se-sidebar-chapter title="Administration"><se-sidebar-button href="<%= settings_users_path %>" label="Users" icon="users" <%= "active" if controller_name == "users" && action_name == "index" %>></se-sidebar-button></se-sidebar-chapter><% end %></section>
          <footer layout-mode="desktop-only"><se-profile data-profile-menu data-account-url="<%= edit_settings_user_path(current_user) %>" name="<%= profile_name %>" subtitle="<%= current_user.email %>" initials="<%= profile_initials %>" options='[{"id":"account","label":"Personal settings","icon":"settings"},{"id":"logout","label":"Log out","icon":"x","danger":true}]'></se-profile><%= button_to "Log out", destroy_user_session_path, method: :delete, form: { id: "logout-form", hidden: true } %></footer>
        </se-sidebar>
        <main class="se-page-layout__content app-content"><%= yield %></main>
      </div>
    </div>
  </body>
</html>
