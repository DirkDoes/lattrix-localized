<%
  profile_name = current_user&.name.presence || "Your account"
  initials = profile_initials(profile_name)
  theme_preference = current_user&.theme_preference.presence_in(User::THEME_PREFERENCES) || "system"
  sidebar_projects = current_user ? policy_scope(Project).where(id: current_user.projects.select(:id)).order(:name).to_a : []
  show_sidebar = current_user.present?
  project_context = @project&.persisted? && !controller_path.start_with?("settings/")
  project_settings = project_context && controller_name == "projects" && %w[settings update destroy].include?(action_name)
  settings_context = !project_context && (controller_path.start_with?("settings/") || @user&.persisted?)
%>
<!DOCTYPE html>
<html data-theme="<%= theme_preference == "dark" ? "dark" : "light" %>" data-se-theme="<%= theme_preference == "dark" ? "flat" : "clean" %>" data-theme-preference="<%= theme_preference %>">
  <head>
    <%= javascript_include_tag "theme", "data-turbo-track": "reload" %>
    <title><%= content_for(:title) || "Lattrix Localized" %></title><meta name="viewport" content="width=device-width,initial-scale=1"><%= csrf_meta_tags %><%= csp_meta_tag %><link rel="icon" href="/icons/lattrix/lattrix-icon-small-light.svg" type="image/svg+xml">
    <link rel="icon" href="/icons/lattrix/lattrix-icon-small-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)"><link rel="apple-touch-icon" href="/icon.png?v=lt">
    <%= stylesheet_link_tag "styles", "application", "data-turbo-track": "reload" %><%= javascript_include_tag "navigation_state", "simple-elements", "icons-all", defer: true, "data-turbo-track": "reload" %><%= javascript_include_tag "ui", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "form_submission", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags "app_forms" %>
    <%= javascript_include_tag "catalog", defer: true, "data-turbo-track": "reload" %>
  </head>
  <body>
    <div class="app-shell">
      <header class="app-topbar">
        <div class="app-topbar-start">
          <% if show_sidebar %><se-panel-toggle class="app-mobile-only" for="app-sidebar" mode="collapse" variant="menu" label="Toggle navigation"></se-panel-toggle><% end %>
          <%= render "shared/layout_brand" %>
        </div>
        <div id="app-project-heading"><%= render "projects/identity" if project_context %></div>
        <% if current_user %>
          <%= render "shared/layout_profile", profile_name: profile_name, initials: initials %>
        <% else %>
          <se-button text="Log in" href="<%= new_user_session_path %>"></se-button>
        <% end %>
      </header>
      <div class="app-scope-row">
        <% if show_sidebar %>
          <turbo-frame id="app-navigation" target="app-content">
            <aside id="app-sidebar" class="app-navigation" aria-label="Workspace navigation" data-navigation-user="<%= current_user.id %>" data-se-minimized="<%= cookies[:sidebar_collapsed] == 'true' %>">
              <se-panel-toggle class="app-desktop-only" for="app-sidebar" mode="minimize" variant="edge" placement="edge-end" label="Minimize navigation"></se-panel-toggle>
              <nav class="app-navigation-scroll" aria-label="Main navigation">
                <se-nav-section title="Workspace">
                  <% if sidebar_projects.any? %>
                    <se-nav-group id="projects-navigation" variant="page" label="Projects" icon="folder" href="<%= projects_path %>" <%= "active" if controller_path == "projects" && action_name == "index" %>>
                      <% sidebar_projects.each do |sidebar_project| %>
                        <se-nav-item label="<%= sidebar_project.name %>" href="<%= project_path(sidebar_project) %>" icon="folder" <%= "active" if project_context && @project.id == sidebar_project.id %>></se-nav-item>
                      <% end %>
                    </se-nav-group>
                  <% else %>
                    <se-nav-item label="Projects" icon="folder" href="<%= projects_path %>" <%= "active" if controller_path == "projects" && action_name == "index" %>></se-nav-item>
                  <% end %>
                  <se-nav-item href="<%= project_invites_path %>" label="Invitations" icon="mail" <%= "active" if controller_name == "project_invites" && params[:project_id].blank? %>></se-nav-item>
                  <se-nav-item href="<%= import_export_path %>" label="Import and Export" icon="download" <%= "active" if controller_name == "formats" %>></se-nav-item>
                </se-nav-section>
                <se-nav-section title="Settings">
                  <se-nav-item href="<%= edit_settings_user_path(current_user) %>" label="Personal settings" icon="user" <%= "active" if settings_context && @user == current_user %>></se-nav-item>
                  <% if policy(User).index? %>
                    <se-nav-item href="<%= settings_users_path %>" label="Administration" icon="shield" <%= "active" if settings_context && @user != current_user %>></se-nav-item>
                  <% end %>
                </se-nav-section>
              </nav>
            </aside>
          </turbo-frame>
          <button class="app-navigation-backdrop" aria-label="Close navigation" tabindex="-1" hidden></button>
        <% end %>
        <%= turbo_frame_tag "app-content", class: "app-workspace", data: { turbo: true, turbo_action: "advance" } do %>
          <template data-project-heading><%= render "projects/identity" if project_context %></template>
          <%= render "projects/navigation" if project_context %>
          <div class="app-content-row">
            <% if show_sidebar && (project_settings || settings_context) %>
              <%= render "shared/settings_navigation", project_settings: project_settings %>
            <% end %>
            <main class="app-content" id="main-content" tabindex="-1">
              <div class="app-content-inner"><%= render "shared/toasts" %><%= yield %></div>
            </main>
          </div>
        <% end %>
      </div>
    </div>
    <% if current_user %><%= button_to "Log out", destroy_user_session_path, method: :delete, form: { id: "logout-form", hidden: true } %><% end %>
  </body>
</html>
