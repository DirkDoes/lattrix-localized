<se-modal id="catalog-key-<%= key.id %>" title="Edit key" size="medium">
  <%= catalog_form catalog_change_project_path(@project), class: "app-form" do %>
    <%= hidden_field_tag :operation, 'update' %><%= hidden_field_tag :revision, @project.revision %><%= hidden_field_tag :node_id, key.id %>
    <se-input label="Name" name="name" value="<%= key.payload.name %>"></se-input>
    <se-select label="Kind" name="kind" value="<%= key.payload.kind %>" options="<%= catalog_kind_options.select { |option| key.payload.kind == 'scalar' ? option[:id] == 'scalar' : option[:id] != 'scalar' }.to_json %>"></se-select>
    <se-input label="Description" name="description" value="<%= key.payload.description %>"></se-input>
    <div class="app-row-actions"><se-button variant="secondary" icon="arrow-right" text="Move" data-open-modal="catalog-move-<%= key.id %>"></se-button><se-button variant="danger" icon="trash" text="Remove" data-open-modal="catalog-delete-<%= key.id %>"></se-button></div>
  <% end %><%= render "shared/modal_footer", confirm: "Save" %>
</se-modal>
<se-modal id="catalog-move-<%= key.id %>" title="Move key" size="medium">
  <%= catalog_form catalog_change_project_path(@project), class: "app-form" do %>
    <%= hidden_field_tag :operation, 'move' %><%= hidden_field_tag :revision, @project.revision %><%= hidden_field_tag :node_id, key.id %>
    <se-input label="New full path" name="path" value="<%= @state.path(key) %>" hint="To turn a scalar into a branch, move its values into a child, for example .other."></se-input>
  <% end %><%= render "shared/modal_footer", confirm: "Move key" %>
</se-modal>
<se-modal id="catalog-delete-<%= key.id %>" title="Remove key and its translations?" size="small" tone="warning">
  <%= catalog_form catalog_change_project_path(@project) do %><%= hidden_field_tag :operation, 'delete' %><%= hidden_field_tag :revision, @project.revision %><%= hidden_field_tag :node_id, key.id %><se-code><%= @state.path(key) %></se-code><% end %>
  <%= render "shared/modal_footer", confirm: "Remove", variant: "danger" %>
</se-modal>
