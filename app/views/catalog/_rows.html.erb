  <% @keys.each do |key| %>
    <% parent_plural = @state.plural_parent(key); next if parent_plural && !([@project.source_locale, @locale].flat_map { |locale| CatalogLocale.categories(locale) }.include?(key.payload.name)) %>
    <se-list-row guides level="<%= @flat_results ? 0 : @state.path(key).count('.') %>" <%= 'collapsible'.html_safe if key.payload.kind != 'scalar' && !@flat_results %> <%= 'variant="secondary"'.html_safe if key.payload.kind != 'scalar' %>>
      <div class="catalog-key"><se-code><%= @flat_results ? @state.path(key) : key.payload.name %></se-code><% if key.payload.kind == 'plural' %><se-badge tone="important" text="Plural"></se-badge><% end %>
    <% if key.parent_id.nil? && key.payload.file_group.present? %><se-badge tone="info" text="<%= key.payload.file_group %>"></se-badge><% end %>
    <% if @drafts[key.id] %><se-badge tone="<%= @drafts[key.id].conflict? ? 'error' : 'warning' %>" text="<%= @drafts[key.id].conflict? ? 'Conflict' : 'Pending' %>"></se-badge><% end %>
    <% if policy(@project).update? && @project.writable? %><se-menu variant="mini" icon-only label="Key actions" data-catalog-history-menu options="<%= [{id: 'edit', label: 'Edit key', icon: 'pencil', modal: "catalog-key-#{key.id}"}].to_json %>"></se-menu><% end %>
      </div>
      <% [@project.source_locale, @locale].each_with_index do |locale, index| %>
    <% value = @state.translation(key.id, locale) %>
    <div class="catalog-value">
      <% if parent_plural && !@state.translatable?(key, locale) %>
        <span aria-label="<%= "This plural form is not used by #{CatalogLocale.name(locale)}" %>">—</span>
      <% elsif @state.translatable?(key, locale) && policy(@project).edit_locale?(locale) && @project.writable? %>
        <div class="translation-cell" data-controller="catalog-cell" data-catalog-cell-url-value="<%= catalog_change_project_path(@project) %>" data-catalog-cell-node-value="<%= key.id %>" data-catalog-cell-locale-value="<%= locale %>" data-catalog-cell-revision-value="<%= @project.revision %>">
          <button type="button" class="translation-value" data-catalog-cell-target="display" data-action="catalog-cell#edit" <%= 'hidden' if value.nil? %>><%= catalog_text(value&.payload&.value) %></button>
          <div data-catalog-cell-target="editor" <%= 'hidden' if value %>>
            <se-input type="textarea" size="small" autosize fixed value="<%= value&.payload&.value %>" aria-label="<%= "#{@state.path(key)} — #{CatalogLocale.name(locale)}" %>" data-catalog-cell-target="input" data-action="input->catalog-cell#changed keydown->catalog-cell#keydown focusout->catalog-cell#blur"></se-input>
          </div>
          <span class="translation-save-status" role="status" aria-live="polite" data-catalog-cell-target="status"></span>
          <div class="catalog-cell-status" data-catalog-status="<%= "#{key.id}-#{locale}" %>"><%= render 'cell_status', key: key, locale: locale %></div>
        </div>
      <% elsif key.payload.kind == 'scalar' || key.payload.kind == 'plural' %>
      <% if key.payload.kind == 'scalar' %><span class="catalog-translation"><%= catalog_text(value&.payload&.value) %></span><% end %>
      <div class="catalog-cell-status" data-catalog-status="<%= "#{key.id}-#{locale}" %>"><%= render 'cell_status', key: key, locale: locale %></div>
      <% end %>
    </div>
      <% end %>
    </se-list-row>
  <% end %>
