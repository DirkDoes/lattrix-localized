<se-card>
  <div class="app-stack">
    <div class="app-heading">
      <se-title level="section">Profile picture</se-title>
      <% if user == current_user %>
        <div class="app-row-actions">
          <% if user.profile_photo.present? %>
            <%= form_with url: profile_photo_path, method: :delete do %><se-button type="submit" variant="ghost" text="Remove picture"></se-button><% end %>
          <% end %>
          <se-button variant="secondary" icon="upload" text="Upload picture" data-open-modal="profile-photo-modal"></se-button>
        </div>
      <% end %>
    </div>
    <se-profile name="<%= user.name %>" subtitle="<%= user.email %>" initials="<%= profile_initials(user.name) %>" image="<%= profile_photo_url_for(user) %>"></se-profile>
    <% if user == current_user %><se-text muted small>Your uploaded picture takes priority. Removing it also stops automatic provider photos.</se-text><% end %>
  </div>
</se-card>
<% if user == current_user %>
  <se-modal id="profile-photo-modal" title="Upload profile picture" subtitle="Choose an image up to 5 MB. Animated images use the first frame." size="medium" icon="upload" tone="brand" <%= "open" if @photo_error %>>
    <%= form_with url: profile_photo_path, method: :patch, multipart: true, html: { novalidate: true }, class: "app-form" do %>
      <se-file-upload data-profile-photo-upload name="photo" label="Profile picture" prompt="Choose an image" accept="image/*" hint="JPEG, PNG, WebP, GIF and other supported raster images · up to 5 MB"></se-file-upload>
      <div data-photo-preview hidden class="app-photo-preview">
        <div class="app-photo-frame">
          <img data-photo-preview-image alt="Selected profile picture preview">
          <div class="app-photo-circle" aria-hidden="true"></div>
        </div>
        <se-text muted small>The circle shows how your picture will appear in your profile.</se-text>
        <se-button type="button" variant="secondary" text="Choose a different picture" data-change-photo></se-button>
      </div>
      <se-text data-photo-filename muted small aria-live="polite"></se-text>
      <% if @photo_error %><se-text role="alert"><%= @photo_error %></se-text><% end %>
    <% end %>
    <%= render "shared/modal_footer", confirm: "Save picture" %>
  </se-modal>
<% end %>
