<section class="app-page">
  <header class="app-heading">
    <div class="app-method-label">
      <se-title level="page">Users</se-title>
      <%= form_with url: settings_users_path, method: :get, data: { segmented_navigation: true } do %>
        <%= hidden_field_tag :q, @query %>
        <se-segmented-control aria-label="User access status" name="status" value="<%= @banned ? 'banned' : 'active' %>" options='[{"id":"active","label":"Active users"},{"id":"banned","label":"Banned users"}]'></se-segmented-control>
      <% end %>
    </div>
    <%= render "shared/table_search", url: settings_users_path, status: (@banned ? "banned" : "active"), placeholder: "Search users" %>
  </header>
  <div class="app-stack" data-table-results>
  <% if @users.any? %>
  <se-collection type="table" columns="minmax(12rem, 1fr) 7rem 8rem 6rem" mobile-columns="minmax(0, 1fr) 5rem 4.5rem">
    <se-list-header><span>User</span><span>Role</span><span layout-mode="desktop-only">Email status</span><span aria-label="Actions"><span layout-mode="desktop-only">Actions</span></span></se-list-header>
    <% @users.each do |user| %>
      <se-list-row>
        <span class="app-user-identity">
          <%= render "shared/table_profile", user: user, show_email: true %>
          <span layout-mode="mobile-only" class="app-verification-status" role="img" aria-label="<%= user.email_verified_at ? 'Email verified' : 'Email unverified' %>" title="<%= user.email_verified_at ? 'Email verified' : 'Email unverified' %>"><se-icon name="<%= user.email_verified_at ? 'circle-check' : 'alert' %>"></se-icon></span>
        </span>
        <se-badge tone="brand" text="<%= user.role.capitalize %>"></se-badge>
        <span layout-mode="desktop-only"><se-badge tone="<%= user.email_verified_at ? 'success' : 'warning' %>" text="<%= user.email_verified_at ? 'Verified' : 'Unverified' %>"></se-badge></span>
        <span class="app-table-actions"><%= render "shared/row_actions", name: user.name, edit_url: (edit_settings_user_path(user) if policy(user).edit?), action_url: (ban_settings_user_path(user) if policy(user).ban?), action_method: :patch, action_label: (user.banned_at ? "Restore access" : "Ban user"), action_icon: (user.banned_at ? "check" : "x"), refresh_table: true %></span>
      </se-list-row>
    <% end %>
  </se-collection>
  <%= render "shared/table_pagination", url: settings_users_path(q: @query, status: (@banned ? "banned" : "active")) %>
  <% elsif @query.present? %>
    <se-empty-illustration variant="search" title="No users found" text="Try another name or email address."></se-empty-illustration>
  <% else %>
    <se-empty-illustration variant="team-2" illustration-label="<%= @banned ? 'Banned' : 'Users' %>" title="<%= @banned ? 'No banned users' : 'No active users' %>" text="<%= @banned ? 'Accounts you ban will appear here. No accounts are currently banned.' : 'Accounts that are not banned will appear here.' %>"></se-empty-illustration>
  <% end %>

  </div>
</section>
