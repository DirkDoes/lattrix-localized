<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
  <tr>
    <td align="center" style="padding: 48px 20px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" class="mail-card" style="max-width: 480px;">
        <tr>
          <td style="padding: 36px; text-align: center;">
            <div style="display: inline-block; padding: 8px 14px; background: rgb(23, 32, 51); border-radius: 10px;"><%= image_tag attachments["lattrix-localized.png"].url, alt: "Lattrix Localized", width: 190, style: "display: block; width: 190px; max-width: 100%; height: auto;" %></div>
            <h1 style="margin: 30px 0 8px; font-size: 24px; line-height: 1.3;">Your verification code</h1>
            <p class="mail-muted" style="margin: 0 0 24px; font-size: 15px; line-height: 1.6;">Use this code to finish signing in.</p>
            <div class="mail-code" style="border-radius: 12px; padding: 18px 20px; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 30px; font-weight: 700; letter-spacing: 8px;"><%= @code %></div>
            <p class="mail-muted" style="margin: 24px 0 0; font-size: 13px; line-height: 1.6;">This code expires in 10 minutes.<br>If you did not request it, you can ignore this email.</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
