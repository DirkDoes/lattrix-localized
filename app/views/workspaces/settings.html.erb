<section class="app-page">
  <%= render "workspaces/navigation" %>
  <header class="app-heading"><se-title level="page">Settings</se-title></header>
  <se-collection type="table" columns="10rem minmax(0, 1fr)" mobile-columns="minmax(0, 1fr)">
    <se-list-row>
      <span>Workspace name</span>
      <%= form_with model: @workspace, class: "app-setting-form", html: { novalidate: true } do %>
        <se-input aria-label="Workspace name" data-controller="control-label" name="workspace[name]" value="<%= @workspace.name %>" error="<%= @workspace.errors[:name].first %>"></se-input>
        <se-button type="submit" variant="brand" text="Save name"></se-button>
      <% end %>
    </se-list-row>
    <se-list-row>
      <span>Identifier</span>
      <% if policy(@workspace).change_slug? %>
        <%= form_with model: @workspace, class: "app-setting-form", html: { novalidate: true } do %>
          <div><se-input aria-label="Identifier" data-controller="control-label" name="workspace[slug]" value="<%= @requested_slug || @workspace.slug %>" error="<%= @workspace.errors[:slug].first %>"></se-input><se-text muted class="app-setting-description">Changing this breaks existing workspace and project links. Old URLs will not redirect.</se-text></div>
          <se-button type="submit" variant="brand" text="Change identifier"></se-button>
        <% end %>
      <% else %>
        <span><se-text><%= @workspace.slug %></se-text><se-text muted>Only an owner can change the workspace identifier.</se-text></span>
      <% end %>
    </se-list-row>
    <se-list-row>
      <span>Visibility</span>
      <% if policy(@workspace).change_visibility? %>
        <%= form_with model: @workspace, class: "app-setting-form", html: { novalidate: true } do %>
          <div>
            <se-select aria-label="Visibility" data-controller="control-label" name="workspace[visibility]" value="<%= @workspace.visibility %>" options='[{"id":"private","label":"Private","icon":"lock"},{"id":"public","label":"Public","icon":"eye"}]'></se-select>
            <% @workspace.errors.full_messages_for(:visibility).each do |error| %><se-text role="alert"><%= error %></se-text><% end %>
            <se-text muted class="app-setting-description">Public workspaces can be viewed with a link. Private workspaces require membership or a pending invitation.</se-text>
          </div>
          <se-button type="submit" variant="brand" text="Change visibility"></se-button>
        <% end %>
      <% else %>
        <span><se-badge tone="brand" text="<%= @workspace.visibility.capitalize %>"></se-badge><se-text muted>Only an owner can change visibility.</se-text></span>
      <% end %>
    </se-list-row>
  </se-collection>
  <% if @confirm_visibility || @confirm_slug %>
    <se-modal id="workspace-visibility-confirmation" title="<%= @confirm_slug ? 'Change workspace identifier?' : "Make this workspace #{@workspace.visibility}?" %>" size="small" icon="alert" tone="warning" cancel-label="Cancel" confirm-label="Confirm and save" data-submit-form open>
      <%= form_with model: @workspace do %>
        <% @pending_attributes.each do |key, value| %><%= hidden_field_tag "workspace[#{key}]", value %><% end %>
        <%= hidden_field_tag :confirm_visibility, "1" if @confirm_visibility %>
        <%= hidden_field_tag :confirm_slug, "1" if @confirm_slug %>
        <% if @confirm_slug %><se-text>The identifier will change to <%= @requested_slug %>. All existing workspace and project links will stop working. No redirects or aliases will be created.</se-text><% end %>
        <% if @confirm_visibility %><se-text><%= @workspace.visibility == "public" ? "Anyone with the link will be able to view this workspace and its public projects." : "Only workspace members and invited accounts will be able to view this workspace and its projects." %></se-text><% end %>
      <% end %>
    </se-modal>
  <% end %>
  <% if policy(@workspace).destroy? %>
    <se-card><div class="app-method-heading">
      <div><se-title level="section">Delete workspace</se-title><se-text muted>Permanently remove this workspace, its projects, memberships and pending invitations. This cannot be undone.</se-text></div>
      <se-button variant="danger" text="Delete workspace" data-open-modal="workspace-delete-warning"></se-button>
    </div></se-card>
    <se-modal id="workspace-delete-warning" title="Delete this workspace?" size="small" icon="alert" tone="error" cancel-label="Cancel" confirm-label="Continue" confirm-variant="danger" data-confirm-next="workspace-delete-confirmation">
      <se-text>This permanently deletes <%= @workspace.name %> and all its projects. You will type a confirmation before anything is deleted.</se-text>
    </se-modal>
    <se-modal id="workspace-delete-confirmation" title="Confirm permanent deletion" size="medium" cancel-label="Cancel" confirm-label="Delete permanently" confirm-variant="danger" data-submit-form <%= "open" if @delete_error %>>
      <%= form_with model: @workspace, method: :delete, class: "app-form", html: { novalidate: true } do %>
        <se-text>Type these words exactly to delete <%= @workspace.name %>.</se-text>
        <se-text class="app-deletion-phrase" data-no-copy>DELETE WORKSPACE</se-text>
        <se-input name="confirmation" label="Confirmation text" autocomplete="off" data-deletion-confirmation error="<%= @delete_error %>"></se-input>
      <% end %>
    </se-modal>
  <% end %>
</section>
