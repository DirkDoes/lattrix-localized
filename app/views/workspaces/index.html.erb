<section class="app-page">
  <header class="app-heading">
    <div><se-title level="page">Workspaces</se-title><se-text muted>Your shared spaces for localization.</se-text></div>
    <div class="app-row-actions">
      <% if @memberships.any? && policy(Workspace).new? %><se-button variant="brand" icon="folder" text="Create new workspace" data-open-modal="workspace-create-modal"></se-button><% end %>
    </div>
  </header>
  <% if @memberships.any? %>
    <div class="app-grid">
      <% @memberships.each do |membership| %>
        <se-workspace-card title="<%= membership.workspace.name %>" metadata="<%= membership.workspace.visibility.capitalize %> · <%= membership.role.capitalize %>" href="<%= workspace_path(membership.workspace) %>"></se-workspace-card>
      <% end %>
    </div>
  <% else %>
    <se-empty-illustration variant="folders" title="No workspaces yet" text="<%= current_user.guest? ? 'Ask a team to invite you to a workspace. Your invitations are available in the sidebar.' : 'Create a workspace to organize your projects and invite your team.' %>">
      <% if policy(Workspace).new? %><se-button variant="brand" icon="folder" text="Create new workspace" data-open-modal="workspace-create-modal"></se-button><% end %>
    </se-empty-illustration>
  <% end %>
  <% if current_user.member? && !policy(Workspace).new? %><se-text muted>You already own three or more workspaces. You can keep using them, but cannot create another with a Member account.</se-text><% end %>
  <% if policy(Workspace).create? %>
  <se-modal id="workspace-create-modal" title="Create a workspace" subtitle="Bring your team together. You'll join as the owner." size="medium" icon="folder" tone="brand" cancel-label="Cancel" confirm-label="Create workspace" <%= "open" if @workspace.errors.any? %>>
    <%= form_with model: @workspace, class: "app-form", data: { controller: "slug-mirror", action: "input->slug-mirror#update" }, html: { novalidate: true } do %>
      <% @workspace.errors[:base].each do |error| %><se-text role="alert"><%= error %></se-text><% end %>
      <div class="app-form-fields">
        <div class="app-form-row">
        <se-input data-slug-mirror-target="source" label="Workspace name" name="workspace[name]" placeholder="e.g. Acme Localization" value="<%= @workspace.name %>" error="<%= @workspace.errors[:name].first %>"></se-input>
        <se-input data-slug-mirror-target="destination" label="Identifier" name="workspace[slug]" value="<%= @workspace.slug %>" error="<%= @workspace.errors[:slug].first %>" hint="Generated from the name until you edit it. Use lowercase letters, numbers, underscores or hyphens."></se-input>
        </div>
        <se-select label="Visibility" name="workspace[visibility]" value="<%= @workspace.visibility %>" options='[{"id":"private","label":"Private","icon":"lock"},{"id":"public","label":"Public","icon":"eye"}]'></se-select>
        <% if @workspace.errors[:visibility].any? %><se-text role="alert"><%= @workspace.errors.full_messages_for(:visibility).to_sentence %></se-text><% end %>
      </div>
    <% end %>
  </se-modal>
  <% end %>
</section>
