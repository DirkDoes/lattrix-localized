<section class="app-page">
  <header class="app-heading">
    <div><se-title level="page">Workspaces</se-title><se-text muted>Your shared spaces for localization.</se-text></div>
    <div class="app-row-actions">
      <se-button variant="secondary" href="<%= workspace_invites_path %>" icon="mail" text="Invitations"></se-button>
      <% unless current_user.guest? %><se-button variant="brand" icon="folder" text="Create workspace" data-open-modal="workspace-create-modal"></se-button><% end %>
    </div>
  </header>
  <% if @memberships.any? %>
    <div class="app-grid">
      <% @memberships.each do |membership| %>
        <se-workspace-card title="<%= membership.workspace.name %>" metadata="<%= membership.workspace.visibility.capitalize %> · <%= membership.role.capitalize %>" href="<%= workspace_path(membership.workspace) %>"></se-workspace-card>
      <% end %>
    </div>
  <% else %>
    <se-card><se-empty-state icon="folder" title="No workspaces yet" text="<%= current_user.guest? ? "Open a shared workspace link or accept an invitation to join one." : "Create a workspace or accept an invitation to join one." %>"></se-empty-state></se-card>
  <% end %>
  <% unless current_user.guest? %>
  <se-modal id="workspace-create-modal" title="Create a workspace" subtitle="Bring your team together. You'll join as the owner." size="medium" icon="folder" tone="brand" cancel-label="Cancel" confirm-label="Create workspace" <%= "open" if @workspace.errors.any? %>>
    <%= form_with model: @workspace, class: "app-form", html: { novalidate: true } do %>
      <div class="app-form-fields">
        <se-input label="Workspace name" name="workspace[name]" placeholder="e.g. Acme Localization" value="<%= @workspace.name %>" error="<%= @workspace.errors[:name].first %>"></se-input>
        <se-input label="Slug" name="workspace[slug]" value="<%= @workspace.slug %>" error="<%= @workspace.errors[:slug].first %>" hint="Optional: leave blank to generate from the name. Use lowercase letters, numbers and hyphens."></se-input>
        <se-select label="Visibility" name="workspace[visibility]" value="<%= @workspace.visibility %>" options='[{"id":"private","label":"Private","icon":"lock"},{"id":"public","label":"Public","icon":"eye"}]'></se-select>
        <% if @workspace.errors[:visibility].any? %><se-text role="alert"><%= @workspace.errors.full_messages_for(:visibility).to_sentence %></se-text><% end %>
      </div>
    <% end %>
  </se-modal>
  <% end %>
</section>
