<se-nav-tabs label="Workspace navigation" value="<%= controller_name == 'projects' ? 'projects' : (action_name == 'members' || controller_name == 'workspace_invites' ? 'members' : 'dashboard') %>" options="<%= [{ id: 'dashboard', label: 'Dashboard', href: workspace_path(@workspace), icon: 'dashboard' }, { id: 'projects', label: 'Projects', href: workspace_projects_path(@workspace), icon: 'folder' }, (@membership ? { id: 'members', label: 'Members', href: members_workspace_path(@workspace), icon: 'users' } : nil)].compact.to_json %>"></se-nav-tabs>
