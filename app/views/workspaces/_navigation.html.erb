<se-nav-tabs label="Workspace navigation" value="<%= controller_name == 'projects' ? 'projects' : (action_name == 'members' || %w[workspace_invites workspace_memberships].include?(controller_name) ? 'members' : (%w[settings update destroy].include?(action_name) ? 'settings' : 'dashboard')) %>" options="<%= [{ id: 'dashboard', label: 'Dashboard', href: workspace_path(@workspace), icon: 'dashboard' }, { id: 'projects', label: 'Projects', href: workspace_projects_path(@workspace), icon: 'folder' }, (policy(@workspace).members? ? { id: 'members', label: 'Members', href: members_workspace_path(@workspace), icon: 'users' } : nil), (policy(@workspace).settings? ? { id: 'settings', label: 'Settings', href: settings_workspace_path(@workspace), icon: 'settings' } : nil)].compact.to_json %>"></se-nav-tabs>
