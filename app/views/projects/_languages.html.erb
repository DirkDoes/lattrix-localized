<se-card><div class="app-stack"><div class="app-heading"><se-title level="section">Languages</se-title><se-button variant="secondary" text="Change source language" data-open-modal="catalog-source-language"></se-button></div>
<se-collection type="table" columns="minmax(0,1fr) 7rem 8rem auto">
  <se-list-header><span>Language</span><span>Identifier</span><span>Status</span><span>Actions</span></se-list-header>
  <% @project.languages.order(:name).each do |language| %>
    <se-list-row><span><%= language.name %><% if language.identifier == @project.source_locale %> <se-badge text="Source" tone="brand"></se-badge><% end %></span><span><se-code><%= language.identifier %></se-code></span><span><se-badge text="<%= language.active? ? 'Active' : 'Archived' %>" tone="<%= language.active? ? 'success' : 'warning' %>"></se-badge></span>
      <div><% unless @project.linked? || language.identifier == @project.source_locale %><%= catalog_form(language.active? ? archive_project_language_path(@project, language) : restore_project_language_path(@project, language), method: :patch) do %><se-button type="submit" variant="secondary" icon="<%= language.active? ? 'archive' : 'rotate-ccw' %>" aria-label="<%= language.active? ? 'Archive language' : 'Restore language' %>"></se-button><% end %><% end %></div>
    </se-list-row>
  <% end %>
</se-collection>
<% unless @project.linked? %>
  <se-button text="Support another language" icon="plus" data-open-modal="catalog-language"></se-button>
  <se-modal id="catalog-language" title="Support another language" size="medium"><%= catalog_form project_languages_path(@project) do %><se-select label="Language" name="identifier" searchable options="<%= CatalogLocale.options.to_json %>"></se-select><% end %><%= render 'shared/modal_footer', confirm: 'Add language' %></se-modal>
<% end %>
</div></se-card>
<se-modal id="catalog-source-language" title="Change source language" size="medium">
  <%= catalog_form source_locale_project_path(@project), class: 'app-form' do %>
    <%= hidden_field_tag :revision, @project.revision %>
    <se-select label="Source language" name="source_locale" value="<%= @project.source_locale %>" options="<%= @project.languages.active.order(:name).map { |language| {id: language.identifier, label: language.name} }.to_json %>"></se-select>
    <se-text muted>This language defines the structure and placeholder validation. Existing translations are kept. The change is only saved if the catalog and pending translations remain valid.</se-text>
  <% end %><%= render 'shared/modal_footer', confirm: 'Change source language' %>
</se-modal>
<se-card><div class="app-stack"><div class="app-heading"><div class="app-method-label"><se-title level="section">GitHub</se-title>
<% if policy(GithubAppConfiguration).show? %><se-button variant="mini" text="Go to Global GitHub App settings" href="<%= settings_github_app_path %>"></se-button><% end %>
</div>
<% if !@project.linked? %><se-badge tone="gray" text="Not connected"></se-badge>
<% elsif @project.sync_error.present? %><se-badge tone="error" text="Synchronization failed"></se-badge>
<% elsif @project.git_sha.present? %><se-badge tone="success" text="Connected · synchronized"></se-badge>
<% else %><se-badge tone="info" text="Connected · awaiting first synchronization"></se-badge><% end %>
</div>
<se-text muted>The GitHub App is configured once for all projects. These settings select this project's repository and installation.</se-text>
<div class="catalog-github-forms <%= 'catalog-github-forms--connected' if @project.linked? %>">
<%= catalog_form connect_project_path(@project), class: 'catalog-github-connect' do %>
  <se-input label="Repository" name="repository" placeholder="owner/repository" value="<%= @project.repository %>"></se-input>
  <se-input label="GitHub App installation ID" name="installation_id" value="<%= @project.installation_id %>"></se-input>
  <se-input label="Authoritative branch" name="git_branch" placeholder="Repository default branch" value="<%= @project.git_branch %>"></se-input>
  <se-input label="Locale directory" name="locale_directory" value="<%= @project.locale_directory %>"></se-input>
  <se-button type="submit" text="Connect and synchronize"></se-button>
<% end %>
<% if @project.linked? %><%= catalog_form connect_project_path(@project), class: 'catalog-github-disconnect' do %><%= hidden_field_tag :disconnect, '1' %><se-button type="submit" variant="danger" text="Disconnect repository"></se-button><% end %><% end %>
</div>
</div></se-card>
