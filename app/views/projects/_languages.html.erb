<%= form_with model: @project, data: {controller: "configuration-toggle", action: "change->configuration-toggle#submit"} do %>
  <input type="hidden" name="project[advanced_languages]" value="0">
  <se-checkbox variant="switch" name="project[advanced_languages]" value="1" label="Advanced language configuration" <%= 'checked' if @project.advanced_languages? %>></se-checkbox>
<% end %>
<% if @project.advanced_languages? %><%= render "projects/identifier_sets" %><% end %>
<div class="app-stack" data-controller="language-table">
  <se-title level="section">Languages</se-title>
  <se-collection type="table" columns="minmax(0,1fr) minmax(0,1.4fr) auto" data-language-table-target="rows">
    <se-list-header><span>Name</span><span class="app-row-actions">Sheets<se-tooltip content="Leave empty to use this language in all sheets, including future sheets. Select sheets to limit where it is available."><se-button variant="mini" icon="info" aria-label="About language sheets"></se-button></se-tooltip></span><span></span></se-list-header>
    <% @project.languages.active.includes(:sheet_languages).order(:name).each do |language| %>
      <%= render "projects/language_row", language: language %>
      <% if @project.advanced_languages? %><%= render "projects/language_identifiers", language: language %><% end %>
    <% end %>
  </se-collection>
  <se-button class="app-language-add" variant="secondary" icon="plus" text="Add language" data-action="click->language-table#add"></se-button>
  <template data-language-table-target="template"><%= render "projects/language_row", language: @project.languages.new %></template>
</div>
<% archived = @project.languages.where(status: %w[archived pending_deletion]).order(:name) %>
<% if archived.any? %>
  <div class="app-stack">
    <se-title level="section">Archived languages</se-title>
    <se-collection type="table" columns="minmax(0,1fr) 10rem auto">
      <se-list-header><span>Name</span><span>Status</span><span>Actions</span></se-list-header>
      <% archived.each do |language| %>
        <se-list-row>
          <span><strong><%= language.name %></strong><br><se-text muted small><%= language.identifier %></se-text></span>
          <se-badge tone="<%= language.pending_deletion? ? 'warning' : 'gray' %>" text="<%= language.pending_deletion? ? 'Pending deletion' : 'Archived' %>"></se-badge>
          <span class="app-row-actions">
            <% if language.archived? %>
              <%= form_with url: restore_project_language_path(@project, language), method: :patch do %><se-button type="submit" variant="secondary" icon="rotate-ccw" text="Restore"></se-button><% end %>
              <se-button variant="danger" icon="trash" text="Delete" data-open-modal="delete-language-<%= language.id %>"></se-button>
            <% end %>
          </span>
        </se-list-row>
        <% if language.archived? %>
          <se-modal id="delete-language-<%= language.id %>" title="Permanently delete <%= language.name %>?" size="small" icon="alert" tone="error" cancel-label="Cancel" confirm-label="Delete permanently" confirm-variant="danger" data-submit-form>
            <%= form_with url: project_language_path(@project, language), method: :delete do %>
              <se-text>This permanently deletes every translation, recording, and history event for this language. This cannot be undone.</se-text>
            <% end %>
          </se-modal>
        <% end %>
      <% end %>
    </se-collection>
  </div>
<% end %>
