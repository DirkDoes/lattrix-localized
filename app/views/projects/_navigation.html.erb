<se-nav-tabs class="app-page-navigation" label="Project navigation" value="<%= controller_name == 'sheets' ? 'sheets' : (action_name == 'members' || %w[project_invites project_memberships].include?(controller_name) ? 'members' : (%w[settings update destroy].include?(action_name) ? 'settings' : 'sheets')) %>" options="<%= [{ id: 'sheets', label: 'Sheets', href: project_sheets_path(@project), icon: 'folder' }, (policy(@project).members? ? { id: 'members', label: 'Members', href: members_project_path(@project), icon: 'users' } : nil), (policy(@project).settings? ? { id: 'settings', label: 'Settings', href: settings_project_path(@project), icon: 'settings' } : nil)].compact.to_json %>"><span data-actions class="app-export-action"><% if policy_scope(@project.sheets).exists? %><se-button text="Export" variant="secondary" data-open-modal="export-modal"></se-button><% end %></span></se-nav-tabs>
  <%= render "shared/export_button", sheet: nil %>
